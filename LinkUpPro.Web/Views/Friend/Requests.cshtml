@model LinkUpPro.Application.ViewModels.FriendRequestsViewModel

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Solicitudes de amistad</h2>
    <a asp-action="NewRequest" class="btn btn-primary">Nueva solicitud de amistad</a>
</div>

<h5>Pendientes de responder</h5>
@if (Model.Received.Count == 0)
{
    <div class="alert alert-info">No tiene solicitudes de amistad pendientes de responder.</div>
}
else
{
    foreach (var r in Model.Received)
    {
        <div class="card mb-2">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <img src="@(string.IsNullOrEmpty(r.OtherProfilePicture) ? "/images/default-avatar.svg" : r.OtherProfilePicture)"
                         width="44" height="44" class="rounded-circle me-2" style="object-fit:cover;" />
                    <div>
                        <strong>@r.OtherFullName</strong> (@r.OtherUserName)
                        <div class="small text-muted">
                            @r.MutualFriendsCount amigo(s) en común &middot; @r.SentDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                        </div>
                    </div>
                </div>
                <div>
                    <a asp-action="AcceptConfirm" asp-route-id="@r.Id" class="btn btn-sm btn-success">Aceptar</a>
                    <a asp-action="RejectConfirm" asp-route-id="@r.Id" class="btn btn-sm btn-outline-danger">Rechazar</a>
                </div>
            </div>
        </div>
    }
}

<h5 class="mt-4">Solicitudes enviadas</h5>
@if (Model.Sent.Count == 0)
{
    <div class="alert alert-info">No ha enviado solicitudes de amistad.</div>
}
else
{
    foreach (var r in Model.Sent)
    {
        <div class="card mb-2">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <img src="@(string.IsNullOrEmpty(r.OtherProfilePicture) ? "/images/default-avatar.svg" : r.OtherProfilePicture)"
                         width="44" height="44" class="rounded-circle me-2" style="object-fit:cover;" />
                    <div>
                        <strong>@r.OtherFullName</strong> (@r.OtherUserName)
                        <div class="small text-muted">
                            Estado: @(r.Status switch { "Pending" => "En espera de respuesta", "Accepted" => "Aceptada", "Rejected" => "Rechazada", _ => r.Status })
                            &middot; Enviada: @r.SentDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            @if (r.RespondedDate.HasValue)
                            {
                                <text> &middot; Respondida: @r.RespondedDate.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</text>
                            }
                        </div>
                    </div>
                </div>
                <div>
                    @if (r.Status == "Pending")
                    {
                        <a asp-action="CancelConfirm" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary">Cancelar solicitud</a>
                    }
                    else
                    {
                        <a asp-action="HideFromHistoryConfirm" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary">Eliminar del historial</a>
                    }
                </div>
            </div>
        </div>
    }
}
