@model LinkUpPro.Application.ViewModels.FriendProfileViewModel

<a asp-action="Index" class="btn btn-sm btn-secondary mb-3">Volver atrás</a>

<div class="card mb-3">
    <div class="card-body d-flex align-items-center">
        <img src="@(string.IsNullOrEmpty(Model.ProfilePicture) ? "/images/default-avatar.svg" : Model.ProfilePicture)"
             width="80" height="80" class="rounded-circle me-3" style="object-fit:cover;" />
        <div>
            <h4 class="mb-0">@Model.FirstName @Model.LastName</h4>
            <div class="text-muted">@Model.UserName</div>
            @if (Model.MutualFriends.Count > 0)
            {
                <button type="button" class="btn btn-link btn-sm p-0 small" data-bs-toggle="collapse" data-bs-target="#mutualFriendsList">
                    @Model.MutualFriends.Count amigo(s) en común
                </button>
            }
            else
            {
                <div class="small">@Model.MutualFriends.Count amigo(s) en común</div>
            }
        </div>
    </div>
</div>

<div class="card mb-3 collapse" id="mutualFriendsList">
    <div class="card-header">Amigos en común</div>
    <div class="card-body d-flex flex-wrap gap-3">
        @if (Model.MutualFriends.Count == 0)
        {
            <span class="text-muted">No tienen amigos en común.</span>
        }
        else
        {
            foreach (var m in Model.MutualFriends)
            {
                <a asp-action="Profile" asp-route-userId="@m.UserId" class="text-decoration-none text-center" style="width:80px;">
                    <img src="@(string.IsNullOrEmpty(m.ProfilePicture) ? "/images/default-avatar.svg" : m.ProfilePicture)"
                         width="48" height="48" class="rounded-circle" style="object-fit:cover;" />
                    <div class="small">@m.UserName</div>
                </a>
            }
        }
    </div>
</div>

@if (Model.Posts.Count == 0)
{
    <div class="alert alert-info">Este usuario todavía no tiene publicaciones disponibles para usted.</div>
}
else
{
    foreach (var post in Model.Posts)
    {
        <partial name="_PostCard" model="post" />
    }
}
