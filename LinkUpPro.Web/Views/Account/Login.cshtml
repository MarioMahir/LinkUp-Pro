@model LinkUpPro.Application.ViewModels.LoginViewModel

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">

        @TempData["Message"]

    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">

        @TempData["Error"]

    </div>
}

<div class="row justify-content-center">
    <div class="col-md-4">
        <h2 class="mb-4 text-center">Iniciar Sesión</h2>

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <form asp-controller="Account"
              asp-action="Login"
              method="post" class="card shadow-sm p-4">

            <div class="mb-3">
                <label class="form-label fw-bold">Usuario</label>
                <input asp-for="UserName" class="form-control" placeholder="Introduce tu usuario" />
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Contraseña</label>
                <div class="input-group">
                    <input asp-for="Password" id="password" class="form-control" placeholder="Introduce tu contraseña" />
                    <button type="button" class="btn btn-outline-secondary" id="togglePassword">Mostrar</button>
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-1 form-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <label class="form-check-label">Mantener sesión iniciada</label>
            </div>
            <small class="text-muted d-block mb-3">Seleccione esta opción únicamente si está utilizando un dispositivo personal.</small>

            <button type="submit" class="btn btn-primary w-100 mb-3">Iniciar sesión</button>

            <div class="text-center d-flex flex-column gap-2">
                <a asp-action="Register" class="text-decoration-none">Registrarse</a>
                <a asp-action="ForgotPassword" class="text-decoration-none text-muted">Restablecer contraseña</a>
                <a asp-action="ResendActivation" class="text-decoration-none text-muted" style="font-size: 0.9em;">Reenviar correo de activación</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        wireTogglePassword("togglePassword", "password");
    </script>
}
