@model LinkUpPro.Application.ViewModels.RegisterViewModel

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <h2 class="mb-4 text-center">Registro</h2>

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <form asp-controller="Account"
              asp-action="Register"
              method="post"
              enctype="multipart/form-data" 
              class="card shadow-sm p-4">

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Nombre</label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Apellido</label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Teléfono</label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Correo</label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Foto</label>
                <input asp-for="ProfilePicture" type="file" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Usuario</label>
                <input asp-for="UserName" class="form-control" />
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Contraseña</label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
                <div class="progress mt-2" style="height: 5px;">
                    <div id="strength-bar" class="progress-bar bg-danger" role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
                <small id="strength-text" class="text-muted mt-1 d-block text-end">Fortaleza: Ninguna</small>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold">Confirmar contraseña</label>
                <input asp-for="ConfirmPassword" class="form-control" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">
                Registrarse
            </button>

            <div class="text-center mt-3">
                <a asp-action="Login" class="text-decoration-none">¿Ya tienes cuenta? Inicia sesión</a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<script>

    let password = document.getElementById("Password");
    let strengthBar = document.getElementById("strength-bar");
    let strengthText = document.getElementById("strength-text");

    password.addEventListener("input", function() {
        let value = password.value;
        let score = 0;

        if(value.length >= 8) score++;
        if(/[A-Z]/.test(value)) score++;
        if(/[a-z]/.test(value)) score++;
        if(/\d/.test(value)) score++;
        if(/[\W_]/.test(value)) score++;

        let percentage = (score / 5) * 100;
        strengthBar.style.width = percentage + "%";

        // Reset classes
        strengthBar.classList.remove("bg-danger", "bg-warning", "bg-success");
        strengthText.classList.remove("text-danger", "text-warning", "text-success");
        
        if (value.length === 0){
             strengthText.innerHTML = "Fortaleza: Ninguna";
             strengthText.classList.add("text-muted");
             strengthBar.classList.add("bg-danger");
        } else if (score <= 2) {
             strengthText.innerHTML = "Fortaleza: Débil";
             strengthText.classList.add("text-danger");
             strengthBar.classList.add("bg-danger");
        } else if(score <= 4) {
             strengthText.innerHTML = "Fortaleza: Media";
             strengthText.classList.add("text-warning");
             strengthBar.classList.add("bg-warning");
        } else {
             strengthText.innerHTML = "Fortaleza: Fuerte";
             strengthText.classList.add("text-success");
             strengthBar.classList.add("bg-success");
        }
    });

</script>