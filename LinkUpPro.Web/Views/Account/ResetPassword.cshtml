@model LinkUpPro.Application.ViewModels.ResetPasswordViewModel

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <h2 class="mb-4 text-center">Nueva contraseña</h2>

        <div asp-validation-summary="All"
             class="text-danger mb-3">
        </div>

        <form asp-action="ResetPassword"
              method="post"
              class="card shadow-sm p-4">

            <input hidden asp-for="UserId" />
            <input hidden asp-for="Token" />

            <div class="mb-3">
                <label class="form-label fw-bold">Nueva contraseña</label>
                <div class="input-group">
                    <input asp-for="NewPassword" id="password" class="form-control" />
                    <button class="btn btn-outline-secondary" type="button" id="togglePassword">Mostrar</button>
                </div>
                <span asp-validation-for="NewPassword" class="text-danger"></span>
                <div class="progress mt-2" style="height: 5px;">
                    <div id="strength-bar" class="progress-bar bg-danger" role="progressbar" style="width: 0%;"></div>
                </div>
                <small id="strength-text" class="text-muted mt-1 d-block text-end">Fortaleza: Ninguna</small>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold">Confirmar contraseña</label>
                <div class="input-group">
                    <input asp-for="ConfirmPassword" id="confirmPassword" class="form-control" />
                    <button class="btn btn-outline-secondary" type="button" id="toggleConfirmPassword">Mostrar</button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">
                Guardar contraseña
            </button>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        wireTogglePassword("togglePassword", "password");
        wireTogglePassword("toggleConfirmPassword", "confirmPassword");
        wirePasswordStrengthMeter("password", "strength-bar", "strength-text");
    </script>
}
