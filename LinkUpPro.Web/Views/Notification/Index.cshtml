@model List<LinkUpPro.Application.ViewModels.NotificationViewModel>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Notificaciones</h2>
    <form asp-controller="Notification" asp-action="MarkAllAsRead" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-primary btn-sm">Marcar todas como leídas</button>
    </form>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Todavía no tiene notificaciones.</div>
}
else
{
    <div class="list-group">
        @foreach (var n in Model)
        {
            <div class="list-group-item d-flex justify-content-between align-items-start @(n.IsRead ? "" : "list-group-item-light fw-bold")">
                <div class="d-flex">
                    <img src="@(string.IsNullOrEmpty(n.ActorProfilePicture) ? "/images/default-avatar.svg" : n.ActorProfilePicture)"
                         width="40" height="40" class="rounded-circle me-2" style="object-fit:cover;" />
                    <div>
                        <a asp-controller="Notification" asp-action="Open" asp-route-id="@n.Id" class="text-decoration-none">
                            @n.Description
                        </a>
                        <div class="small text-muted">@n.CreatedDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                </div>
                <div class="text-end">
                    @if (!n.IsRead)
                    {
                        <span class="badge bg-primary mb-1">No leída</span>
                        <form asp-controller="Notification" asp-action="MarkAsRead" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@n.Id" />
                            <button type="submit" class="btn btn-link btn-sm p-0">Marcar como leída</button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
}
