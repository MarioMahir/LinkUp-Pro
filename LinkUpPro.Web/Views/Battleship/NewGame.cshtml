@model LinkUpPro.Application.ViewModels.BattleshipNewGameViewModel

<h2>Nueva partida de Battleship</h2>

<form method="get" class="input-group mb-3">
    <input name="search" value="@Model.SearchText" class="form-control" placeholder="Buscar por nombre de usuario..." />
    <button class="btn btn-outline-secondary" type="submit">Buscar</button>
</form>

<form asp-action="Start" method="post">
    @Html.AntiForgeryToken()

    @if (Model.Opponents.Count == 0)
    {
        <div class="alert alert-info">No hay amigos disponibles para iniciar una nueva partida.</div>
    }
    else
    {
        <div class="list-group mb-3">
            @foreach (var u in Model.Opponents)
            {
                <label class="list-group-item d-flex align-items-center">
                    <input type="radio" name="selectedUserId" value="@u.UserId" class="form-check-input me-3" />
                    <img src="@(string.IsNullOrEmpty(u.ProfilePicture) ? "/images/default-avatar.svg" : u.ProfilePicture)"
                         width="40" height="40" class="rounded-circle me-2" style="object-fit:cover;" />
                    @u.UserName
                </label>
            }
        </div>
    }

    <a asp-action="Index" class="btn btn-secondary">Volver atrás</a>
    <button type="submit" class="btn btn-primary">Iniciar partida</button>
</form>
