@model LinkUpPro.Application.ViewModels.SelectDirectionViewModel

<h2>Posicionar barco de @Model.Length posiciones</h2>
<p class="text-muted">Celda inicial seleccionada: fila @(Model.Row + 1), columna @(Model.Col + 1).</p>

<div asp-validation-summary="All" class="text-danger mb-3"></div>

<form asp-action="PlaceShip" method="post" class="card p-4" style="max-width:400px;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="gameId" value="@Model.GameId" />
    <input type="hidden" name="length" value="@Model.Length" />
    <input type="hidden" name="startRow" value="@Model.Row" />
    <input type="hidden" name="startCol" value="@Model.Col" />

    <label class="form-label fw-bold">Dirección</label>
    <select name="direction" class="form-select mb-3">
        <option value="Up">Hacia arriba</option>
        <option value="Down">Hacia abajo</option>
        <option value="Left">Hacia la izquierda</option>
        <option value="Right">Hacia la derecha</option>
    </select>

    <a asp-action="PlaceShip" asp-route-id="@Model.GameId" asp-route-length="@Model.Length" class="btn btn-secondary">Volver atrás</a>
    <button type="submit" class="btn btn-primary">Posicionar</button>
</form>
