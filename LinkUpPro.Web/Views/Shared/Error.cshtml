@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <h1 class="text-danger">Ocurrió un error</h1>
        <p class="lead">Ocurrió un error al procesar la solicitud. Inténtelo nuevamente.</p>

        @if (Model.ShowRequestId)
        {
            <p class="text-muted small">Referencia: <code>@Model.RequestId</code></p>
        }

        <a class="btn btn-primary mt-3" href="/">Volver al inicio</a>
    </div>
</div>
