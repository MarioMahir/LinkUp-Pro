<!DOCTYPE html>

<html>

<head>

    <title>LinkUp Pro</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
          rel="stylesheet" />

</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">

        <div class="container">

            <a class="navbar-brand"
               asp-controller="Home"
               asp-action="Index">

                LinkUp Pro

            </a>

            <ul class="navbar-nav">

                <li class="nav-item">

                    <a class="nav-link"
                       asp-controller="Home"
                       asp-action="Index">

                        Home

                    </a>

                </li>

                <li class="nav-item">

                    <a class="nav-link">

                        Amigos

                    </a>

                </li>

                <li class="nav-item">

                    <a class="nav-link">

                        Solicitudes

                        <span class="badge bg-danger">

                            3

                        </span>

                    </a>

                </li>

                <li class="nav-item">

                    <a class="nav-link">

                        Notificaciones

                        <span class="badge bg-danger">

                            5

                        </span>

                    </a>

                </li>

                <li class="nav-item">

                    <a class="nav-link">

                        Battleship

                    </a>

                </li>

                <li class="nav-item">

                    <a class="nav-link">

                        Mi perfil

                    </a>

                </li>

                <li class="nav-item">

                    <form method="post"
                          asp-controller="Account"
                          asp-action="Logout">

                        @Html.AntiForgeryToken()

                        <button class="btn btn-danger">

                            Cerrar sesión

                        </button>

                    </form>

                </li>

            </ul>

        </div>

    </nav>

    <div class="container mt-4">

        @RenderBody()

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync(
    "Scripts",
        required: false)

</body>

</html>