<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " - LinkUp Pro" : "LinkUp Pro")</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">LinkUp Pro</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Friend" asp-action="Index">Amigos</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Friend" asp-action="Requests">
                            Solicitudes de amistad
                            @await Component.InvokeAsync("NavCounters", new { type = "requests" })
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Notification" asp-action="Index">
                            Notificaciones
                            @await Component.InvokeAsync("NavCounters", new { type = "notifications" })
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Battleship" asp-action="Index">Battleship</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Profile" asp-action="Index">Mi perfil</a>
                    </li>
                </ul>
                <form method="post" asp-controller="Account" asp-action="Logout" class="d-flex">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-light">Cerrar sesión</button>
                </form>
            </div>
        </div>
    </nav>

    <div class="container mb-5">
        <partial name="_StatusMessages" />
        @RenderBody()
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
