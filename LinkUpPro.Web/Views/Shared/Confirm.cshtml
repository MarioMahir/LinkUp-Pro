@model LinkUpPro.Application.ViewModels.ConfirmActionViewModel

<div class="row justify-content-center">
    <div class="col-md-6">
        <h2>@Model.Title</h2>

        <div class="card p-4">
            <p class="mb-4">@Model.Message</p>

            <form asp-controller="@Model.FormController" asp-action="@Model.FormAction" method="post">
                @Html.AntiForgeryToken()
                @foreach (var field in Model.HiddenFields)
                {
                    <input type="hidden" name="@field.Key" value="@field.Value" />
                }
                <a href="@Model.CancelUrl" class="btn btn-secondary">Cancelar</a>
                <button type="submit" class="btn @Model.ConfirmButtonClass">@Model.ConfirmButtonText</button>
            </form>
        </div>
    </div>
</div>
