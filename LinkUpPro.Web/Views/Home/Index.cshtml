@model LinkUpPro.Application.ViewModels.HomeViewModel

<div class="container mt-4">

    <!-- Menú -->

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark rounded p-3">

        <div class="container-fluid">

            <a class="navbar-brand">
                LinkUp Pro
            </a>

            <div class="navbar-nav">

                <a class="nav-link active"
                   asp-controller="Home"
                   asp-action="Index">
                    Home
                </a>

                <a class="nav-link">
                    Amigos
                </a>

                <a class="nav-link">

                    Solicitudes

                    @if (Model.PendingRequestsCount > 0)
                    {
                        <span class="badge bg-danger">

                            @Model.PendingRequestsCount

                        </span>
                    }

                </a>

                <a class="nav-link">

                    Notificaciones

                    @if (Model.UnreadNotificationsCount > 0)
                    {
                        <span class="badge bg-warning">

                            @Model.UnreadNotificationsCount

                        </span>
                    }

                </a>

                <a class="nav-link">
                    Battleship
                </a>

                <a class="nav-link">
                    Mi perfil
                </a>

                <a class="nav-link text-danger"
                   asp-controller="Account"
                   asp-action="Logout">

                    Cerrar sesión

                </a>

            </div>

        </div>

    </nav>


    <br />

    <!-- Crear publicación -->

    <div class="card">

        <div class="card-header">

            Crear publicación

        </div>

        <div class="card-body">

            <form asp-controller="Home"
                  asp-action="CreatePost"
                  method="post"
                  enctype="multipart/form-data">

                <div class="mb-3">

                    <textarea asp-for="NewPost.Content"
                              class="form-control"
                              placeholder="¿Qué estás pensando?">
                    </textarea>

                </div>

                <div class="mb-3">

                    <label>
                        Tipo contenido
                    </label>

                    <select asp-for="NewPost.ContentType"
                            id="contentType"
                            class="form-select">

                        <option value="">
                            Seleccione
                        </option>

                        <option value="Image">
                            Imagen
                        </option>

                        <option value="YouTube">
                            Video YouTube
                        </option>

                    </select>

                </div>

                <div id="imageSection"
                     style="display:none">

                    <input asp-for="NewPost.ImageFile"
                           class="form-control"
                           type="file" />

                </div>

                <div id="youtubeSection"
                     style="display:none">

                    <input asp-for="NewPost.YoutubeUrl"
                           class="form-control"
                           placeholder="Enlace YouTube" />

                </div>

                <br />

                <div>

                    <select asp-for="NewPost.Privacy"
                            class="form-select">

                        <option value="Friends">
                            Solo amigos
                        </option>

                        <option value="OnlyMe">
                            Solo yo
                        </option>

                    </select>

                </div>

                <br />

                <div class="form-check">

                    <input asp-for="NewPost.AllowComments"
                           class="form-check-input" />

                    <label class="form-check-label">

                        Permitir comentarios

                    </label>

                </div>

                <br />

                <button class="btn btn-primary">

                    Publicar

                </button>

            </form>

        </div>

    </div>

    <br />

    <!-- Filtros -->

    <div class="card">

        <div class="card-header">

            Buscar publicaciones

        </div>

        <div class="card-body">

            <form method="get">

                <div class="row">

                    <div class="col">

                        <input asp-for="SearchText"
                               class="form-control"
                               placeholder="Buscar" />

                    </div>

                    <div class="col">

                        <select asp-for="ContentType"
                                class="form-select">

                            <option value="">
                                Todos
                            </option>

                            <option value="Image">
                                Imagen
                            </option>

                            <option value="YouTube">
                                Video
                            </option>

                        </select>

                    </div>

                    <div class="col">

                        <input asp-for="DateFrom"
                               type="date"
                               class="form-control" />

                    </div>

                    <div class="col">

                        <input asp-for="DateTo"
                               type="date"
                               class="form-control" />

                    </div>

                </div>

                <br />

                <button class="btn btn-success">

                    Buscar

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Limpiar

                </a>

            </form>

        </div>

    </div>

    <br />

    <!-- Publicaciones -->
    @if (Model.Posts.Count == 0)
    {
        <div class="alert alert-info">

            Todavía no ha realizado ninguna publicación.

        </div>
    }

    else
    {
        @foreach (var post in Model.Posts)
        {
            <div class="card mb-3">

                <div class="card-body">

                    <div class="d-flex">

                        <img src="@post.ProfilePicture"
                             width="50"
                             height="50"
                             class="rounded-circle" />

                        <div class="ms-3">

                            <h5>

                                @post.UserName

                            </h5>

                            <small>

                                @post.CreatedDate

                            </small>

                            @if (post.IsEdited)
                            {
                                <span class="badge bg-warning">

                                    Editada

                                </span>
                            }

                        </div>

                    </div>

                    <hr />

                    <p>

                        @post.Content

                    </p>

                    @if (post.ImageUrl != null)
                    {
                        <img src="@post.ImageUrl"
                             class="img-fluid rounded" />
                    }

                    @if (post.YoutubeUrl != null)
                    {
                        <iframe width="100%"
                                height="315"
                                src="@post.YoutubeUrl">
                        </iframe>
                    }

                    <hr />

                    <span>

                        👍 @post.LikesCount

                    </span>

                    <span class="ms-3">

                        👎 @post.DislikesCount

                    </span>

                </div>

            </div>
        }
    }

</div>


<script>

    let contentType=
    document.getElementById(
    "contentType");

    contentType.addEventListener(
    "change",
    function(){

    let image=
    document.getElementById(
    "imageSection");

    let youtube=
    document.getElementById(
    "youtubeSection");

    image.style.display=
    "none";

    youtube.style.display=
    "none";

    if(this.value==="Image")
    {
    image.style.display=
    "block";
    }

    if(this.value==="YouTube")
    {
    youtube.style.display=
    "block";
    }

    });

</script>