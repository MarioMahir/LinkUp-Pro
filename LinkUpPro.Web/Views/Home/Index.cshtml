@model LinkUpPro.Application.ViewModels.HomeViewModel

<div class="card mb-3">
    <div class="card-header">Crear publicación</div>
    <div class="card-body">
        <form asp-controller="Home" asp-action="CreatePost" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <textarea asp-for="NewPost.Content" class="form-control" placeholder="¿Qué estás pensando?" maxlength="1000"></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Tipo de contenido</label>
                <select asp-for="NewPost.ContentType" id="contentType" class="form-select">
                    <option value="">Seleccione</option>
                    <option value="Image">Imagen</option>
                    <option value="YouTube">Video de YouTube</option>
                </select>
            </div>

            <div id="imageSection" class="mb-3" style="display:none">
                <label class="form-label fw-bold">Imagen</label>
                <input asp-for="NewPost.ImageFile" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp" />
            </div>

            <div id="youtubeSection" class="mb-3" style="display:none">
                <label class="form-label fw-bold">Enlace de YouTube</label>
                <input asp-for="NewPost.YoutubeUrl" class="form-control" placeholder="https://www.youtube.com/watch?v=..." />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Privacidad</label>
                <select asp-for="NewPost.Privacy" class="form-select">
                    <option value="Friends">Solo amigos</option>
                    <option value="OnlyMe">Solo yo</option>
                </select>
            </div>

            <div class="form-check mb-3">
                <input asp-for="NewPost.AllowComments" class="form-check-input" />
                <label class="form-check-label">Permitir comentarios</label>
            </div>

            <button class="btn btn-primary">Publicar</button>
        </form>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">Buscar publicaciones</div>
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-md-3">
                <input asp-for="SearchText" class="form-control" placeholder="Buscar" />
            </div>
            <div class="col-md-2">
                <select asp-for="ContentType" class="form-select">
                    <option value="">Todos</option>
                    <option value="Image">Imagen</option>
                    <option value="YouTube">Video de YouTube</option>
                </select>
            </div>
            <div class="col-md-2">
                <input asp-for="DateFrom" type="date" class="form-control" />
            </div>
            <div class="col-md-2">
                <input asp-for="DateTo" type="date" class="form-control" />
            </div>
            <div class="col-md-2">
                <select asp-for="EditedStatus" class="form-select">
                    <option value="">Todas</option>
                    <option value="Edited">Editadas</option>
                    <option value="NotEdited">No editadas</option>
                </select>
            </div>
            <div class="col-md-1 d-flex align-items-start">
                <button class="btn btn-success me-1" type="submit">Buscar</button>
            </div>
            <div>
                <a asp-action="Index" class="btn btn-secondary btn-sm">Limpiar filtros</a>
            </div>
        </form>
    </div>
</div>

@if (Model.Posts.Count == 0)
{
    <div class="alert alert-info">Todavía no ha realizado ninguna publicación.</div>
}
else
{
    foreach (var post in Model.Posts)
    {
        <partial name="_PostCard" model="post" />
    }
}

<script>
    var contentType = document.getElementById("contentType");
    if (contentType) {
        contentType.addEventListener("change", function () {
            var image = document.getElementById("imageSection");
            var youtube = document.getElementById("youtubeSection");
            image.style.display = "none";
            youtube.style.display = "none";
            if (this.value === "Image") image.style.display = "block";
            if (this.value === "YouTube") youtube.style.display = "block";
        });
    }
</script>
